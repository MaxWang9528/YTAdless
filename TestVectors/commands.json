{
  "description": "Native → JS commands (PLAN.md §5.4). `args` is what JSCommand.argumentsJSON parses to; `swift` is the case that produces it. Handlers receive `args` as an object.",
  "commands": [
    { "swift": ".play",                                         "name": "play",              "args": {},                                         "handler": "player-bridge.js" },
    { "swift": ".pause",                                        "name": "pause",             "args": {},                                         "handler": "player-bridge.js" },
    { "swift": ".seek(to: 42.5)",                               "name": "seek",              "args": { "to": 42.5 },                             "handler": "player-bridge.js" },
    { "swift": ".seekBy(-10)",                                  "name": "seekBy",            "args": { "delta": -10 },                           "handler": "player-bridge.js" },
    { "swift": ".pip(enter: true)",                             "name": "pip",               "args": { "enter": true },                          "handler": "player-bridge.js" },
    { "swift": ".state",                                        "name": "state",             "args": {},                                         "handler": "player-bridge.js" },
    { "swift": ".lifecycle(.background)",                       "name": "lifecycle",         "args": { "state": "background" },                  "handler": "background.js" },
    { "swift": ".audioInterruption(began: false, shouldResume: true)", "name": "audioInterruption", "args": { "phase": "ended", "shouldResume": true }, "handler": "background.js" },
    { "swift": ".layout(.video)",                               "name": "layout",            "args": { "mode": "video" },                        "handler": "layout.js" },
    { "swift": ".capture",                                      "name": "capture",           "args": {},                                         "handler": "debug.js" },
    { "swift": ".sponsorSegments(videoId: \"dQw4w9WgXcQ\", segments: [SkipSegment(start: 10, end: 30.5, category: \"sponsor\")])", "name": "sponsorSegments", "args": { "autoSkip": true, "segments": [{ "category": "sponsor", "end": 30.5, "start": 10 }], "videoId": "dQw4w9WgXcQ" }, "handler": "sponsorblock.js" },
    { "swift": ".captionTracks",                                "name": "captionTracks",     "args": {},                                         "handler": "sponsorblock.js" },
    { "swift": ".suggestedSegments(videoId: \"dQw4w9WgXcQ\", segments: [SkipSegment(start: 61, end: 95, category: \"sponsor\")])", "name": "suggestedSegments", "args": { "autoSkip": false, "segments": [{ "category": "sponsor", "end": 95, "start": 61 }], "videoId": "dQw4w9WgXcQ" }, "handler": "sponsorblock.js" }
  ]
}
